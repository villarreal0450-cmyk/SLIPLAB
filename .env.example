# ---- Supabase (required for auth, saving bets, chat history) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon key also works
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sports data ----
# "mock" ships demo data. Real providers are added in src/lib/sports/index.ts.
SPORTS_DATA_PROVIDER=mock

# ---- AI analyst (Phase 7) ----
ANTHROPIC_API_KEY=
