# ---- Supabase (required for auth, saving bets, chat history) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon key also works
# via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sports data ----
# "espn": live NFL schedule, rosters, injuries and stats (no key needed).
# "mock": labelled demo slate for offline work and tests.
SPORTS_DATA_PROVIDER=espn
# Sportsbook lines and player props from the-odds-api.com (free tier available).
# Without it, every player is still bettable; you enter the line from your slip.
ODDS_API_KEY=
# Also fetch alternate lines (costs more credits per game).
ODDS_API_ALTERNATES=false

# ---- AI analyst (Phase 7) ----
ANTHROPIC_API_KEY=
